          "medium":  {"likelihood": [0.30, 0.50, 0.20]},
          "high":    {"likelihood": [0.15, 0.40, 0.45]},
          "premium": {"likelihood": [0.10, 0.25, 0.65]}
        },
        "vehicle_condition_preference": {
          "new_only":    {"likelihood": [0.05, 0.15, 0.80]},
          "prefer_new":  {"likelihood": [0.15, 0.35, 0.50]},
          "no_preference":{"likelihood": [0.35, 0.45, 0.20]},
          "prefer_used": {"likelihood": [0.70, 0.25, 0.05]}
        }
      }
    },
    "cng_suitability": {
      "description": "Whether CNG is suitable for user driving patterns and infrastructure",
      "states": ["high", "moderate", "low"],
      "prior": [0.33, 0.34, 0.33],
      "evidence_factors": {
