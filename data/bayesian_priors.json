        },
        "driving_environment_type": {
          "city":    {"likelihood": [0.70, 0.25, 0.05]},
          "mixed":   {"likelihood": [0.50, 0.35, 0.15]},
          "highway": {"likelihood": [0.25, 0.35, 0.40]}
        },
        "fuel_station_access": {
          "easy":      {"likelihood": [0.70, 0.25, 0.05]},
          "moderate":  {"likelihood": [0.40, 0.40, 0.20]},
          "difficult": {"likelihood": [0.10, 0.25, 0.65]}
        }
      }
    }
  }
}
